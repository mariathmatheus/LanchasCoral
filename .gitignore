# Credenciais: NUNCA versionar.
.env
.env.*
!.env.example
infra/.env.tunnel

# Cópias do banco: contêm dados pessoais dos clientes (nome, e-mail, telefone)
# e o hash da senha do painel. Nunca versionar.
infra/backups/

# Dependências e artefatos de build
node_modules/
.next/
out/
dist/

# Sistema
.DS_Store
Thumbs.db

# Cópias antigas de configuração: ficam na máquina, não no repositório.
*.bak-*

# Relatorio do Lighthouse: gerado a cada execucao, nao e fonte.
apps/frontend/audit/_lh.json

# Videos brutos baixados do Drive: pesados e regeraveis.
infra/_videos-brutos/

# Videos comprimidos do hero: gerados por infra/videos-do-drive.mjs.
# Versionar binario de alguns MB por modelo incharia o repositorio.
apps/frontend/public/videos/

# Fotografias do catalogo, trazidas dos WordPress antigos por
# `audit/migrar-imagens.mjs` e convertidas para WebP. Sao 627 arquivos / 126 MB
# que pertencem a Coral, nao ao repositorio — e o conteudo ja vive no banco e
# no volume do servidor. Quem subir do zero roda o migrador ou repoe pelo
# painel, como ja vale para os videos do hero.
apps/frontend/public/fotos/

# Lista das imagens que a origem nao devolveu mais (relatorio do migrador).
apps/frontend/audit/_imagens-perdidas.json

# Captura do site antigo em WordPress, guardada como referência da migração.
# 1,7 MB de HTML que não pertencem ao repositório publicado.
Coral Website (offline).html

# Protótipo de design (Claude Design canvas), anterior à implementação.
# Serviu de ponto de partida; o que vale hoje é o código em apps/frontend.
design/
