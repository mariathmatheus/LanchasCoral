# Porta de entrada do site, com o domínio oficial.
#
# O Caddy termina o TLS de lanchascoral.com.br e repassa para a aplicação pela
# rede interna do compose. Substitui o túnel Cloudflare como caminho
# definitivo: o túnel vive numa conta de terceiro — a da agência, não a da
# Coral — e a entrega de um site não deve depender da infraestrutura de quem o
# construiu.
#
# ## O site fica ATRÁS da Cloudflare (nuvem laranja)
#
# A Cloudflare recebe o tráfego do público e conversa com este servidor. Isso
# muda duas coisas, e as duas estão tratadas abaixo:
#
#   1. O IP de quem acessa chega em `CF-Connecting-IP`, não no IP da conexão —
#      que é o da Cloudflare.
#   2. O desafio HTTP do Let's Encrypt é respondido pela Cloudflare, não por
#      este servidor, então a renovação automática FALHA com a nuvem laranja.
#      Ver "Renovação" no fim deste arquivo.
#
# O modo de SSL na Cloudflare precisa ser **Full (strict)**. Em "Flexible" ela
# falaria HTTP puro com este servidor, e o `upgrade-insecure-requests` da CSP
# faria o navegador bloquear o CSS — o site apareceria sem estilo nenhum.
{
	# Para onde o Let's Encrypt avisa de certificado perto de expirar — o único
	# aviso que chega antes de o site cair. Vale conferir que alguém lê esta
	# caixa: é o alarme de incêndio desta configuração.
	email contato@lanchascoral.com.br

	# Emissor fixo. Sem esta linha o Caddy tenta o Let's Encrypt e, se falhar,
	# cai no ZeroSSL sozinho — e o site passaria a depender de um emissor que
	# ninguém escolheu nem acompanha. Melhor falhar visivelmente num emissor
	# conhecido do que ter sucesso silencioso em outro.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	servers {
		# Só aceita `X-Forwarded-*` e `CF-Connecting-IP` de quem está nas faixas
		# abaixo. Sem isto, qualquer um na internet poderia forjar o cabeçalho e
		# se passar por outro IP — burlando o teto de envios do formulário e
		# envenenando o log de acesso.
		#
		# A lista é estática de propósito. O módulo `trusted_proxies cloudflare`,
		# que a buscaria sozinha, NÃO vem na imagem oficial do Caddy: exige
		# recompilar com xcaddy. Medido — `caddy validate` recusa com "module not
		# registered: http.ip_sources.cloudflare".
		#
		# Estas faixas são as publicadas em https://www.cloudflare.com/ips/ e
		# mudam raramente (a última alteração relevante foi em 2021). Se mudarem,
		# o sintoma é o site ver todos os visitantes com o mesmo IP: compare com
		# a lista do link e atualize aqui.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

		# Recusa o cabeçalho de IP que venha de qualquer outra origem, em vez de
		# aceitá-lo com ressalvas.
		trusted_proxies_strict
	}
}

lanchascoral.com.br {
	# `app` é o nome do serviço no compose; o Docker resolve pela rede interna.
	# A aplicação continua sem publicar porta no host — só o Caddy a alcança.
	reverse_proxy app:3000 {
		# O IP real de quem acessa. Com a Cloudflare na frente, o IP da conexão
		# é o dela: `{remote_host}` daria o mesmo endereço para todo mundo, e o
		# teto de envios por IP do formulário barraria gente legítima depois de
		# alguns envios — ou deixaria passar um abuso vindo de um IP só.
		#
		# `{client_ip}` é o endereço real, extraído do `CF-Connecting-IP` e só
		# confiável porque `trusted_proxies cloudflare` está declarado acima.
		header_up X-Real-IP {client_ip}
	}

	# Compressão. O Next já serve o estático comprimido, mas o HTML renderizado
	# no servidor sai cru — e é o que chega primeiro em toda navegação. A
	# Cloudflare também comprime, mas isto vale para o trecho entre ela e aqui,
	# e para o dia em que a nuvem for desligada.
	encode zstd gzip

	# Quanto tempo a Cloudflare pode guardar o HTML.
	#
	# O Next marca as páginas estáticas com `s-maxage=31536000` — um ano. É um
	# padrão razoável para quem invalida o cache a cada publicação por API, e
	# desastroso para nós: uma página publicada hoje ficaria presa na borda por
	# um ano, e cada deploy exigiria purgar o cache da Cloudflare à mão.
	#
	# Medido: foi assim que o WordPress antigo ficou servindo do cache depois
	# da virada de DNS — ele mandava `max-age=16070400` (186 dias).
	#
	# Cinco minutos é o equilíbrio: a Cloudflare ainda absorve picos de tráfego
	# e ataques, e uma correção publicada aparece para todo mundo em minutos,
	# sem ninguém precisar lembrar de limpar cache nenhum.
	#
	# `stale-while-revalidate` deixa a borda servir a versão guardada enquanto
	# busca a nova por trás: o visitante nunca espera a origem.
	#
	# Só o HTML. Os arquivos em `/_next/static/` têm hash no nome — o conteúdo
	# nunca muda sem o nome mudar junto — e continuam com o cache de um ano que
	# o Next lhes dá.
	@html {
		not path /_next/static/*
	}
	header @html Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"

	# Os cabeçalhos de segurança (CSP, HSTS, X-Frame-Options) são definidos pelo
	# Next, em `next.config.ts`, que é onde a CSP pode ser lida e testada junto
	# do código que ela restringe. Repetir aqui criaria duas fontes de verdade
	# que divergem na primeira alteração; o Caddy apenas não os remove.

	log {
		output file /var/log/caddy/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Dois endereços servindo o mesmo conteúdo são dois sites para o Google, que
# divide a autoridade entre eles. O canonical das páginas já aponta para o
# apex; o 301 torna a regra válida para quem digita o www à mão.
www.lanchascoral.com.br {
	redir https://lanchascoral.com.br{uri} permanent
}

# ## Renovação — exige intervenção, a cada ~60 dias
#
# O Let's Encrypt valida indo buscar um arquivo em
# `http://lanchascoral.com.br/.well-known/acme-challenge/...`. Com a nuvem
# LARANJA, quem atende essa porta é a Cloudflare, não este servidor: ela
# responde 403 e a validação falha. Medido — foi o que aconteceu na primeira
# subida, antes da virada.
#
# O Caddy começa a tentar renovar 30 dias antes de vencer, então há um mês de
# folga para agir. Quando o aviso do Let's Encrypt chegar no e-mail acima:
#
#   1. Nuvem CINZA no registro A de lanchascoral.com.br.
#   2. `docker exec coral-proxy caddy reload --config /etc/caddy/Caddyfile`
#      (ou esperar; ele tenta sozinho algumas vezes por dia).
#   3. Conferir: `docker logs coral-proxy | grep -i "certificate obtained"`.
#   4. Nuvem de volta para LARANJA.
#
# Para eliminar esse passo manual, a saída é validar por DNS-01 em vez de
# HTTP-01: o Caddy cria um registro TXT na Cloudflare e a nuvem nunca precisa
# sair do laranja. Exige um token de API da conta da Coral, com permissão só de
# editar o DNS da zona, e uma imagem do Caddy com o plugin
# `caddy-dns/cloudflare`. Vale fazer quando houver esse token.
