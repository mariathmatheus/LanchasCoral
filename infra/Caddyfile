# Porta de entrada do site, ANTES da virada de domínio.
#
# Serve pelo IP, em HTTP, sem pedir certificado. É de propósito: o Caddy pede o
# certificado assim que sobe, e o Let's Encrypt valida indo buscar um arquivo
# em http://<domínio>/.well-known/. Enquanto `lanchascoral.com.br` apontar para
# a Cloudflare (onde o WordPress ainda está), a validação volta 403 — e cada
# falha conta contra o teto de 5 por hora da conta. Medido: a primeira subida
# com o domínio declarado queimou algumas tentativas assim.
#
# No dia da virada, a sequência é:
#
#   1. Registro A de lanchascoral.com.br e www → 216.128.171.143,
#      com a nuvem da Cloudflare CINZA (laranja intercepta o desafio).
#   2. `dig +short lanchascoral.com.br` devolvendo o IP.
#   3. `cp infra/Caddyfile.dominio infra/Caddyfile` e commit.
#   4. O deploy sobe o Caddy, que emite o certificado no primeiro acesso.
#
# A configuração final, com domínio e TLS, está em `Caddyfile.dominio`.
{
	email contato@lanchascoral.com.br
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# `:80` sem nome de host: atende qualquer endereço, inclusive o IP cru, e não
# dispara emissão de certificado nenhuma.
:80 {
	reverse_proxy app:3000 {
		# O IP real de quem acessa. Sem isto, o teto de envios por IP do
		# formulário veria todos os visitantes como o mesmo endereço (o do
		# contêiner do Caddy) e barraria gente legítima depois de alguns envios.
		header_up X-Real-IP {remote_host}
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
