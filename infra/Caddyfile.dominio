# Porta de entrada do site.
#
# O Caddy termina o TLS e repassa para a aplicação pela rede interna do
# compose. Substitui o túnel Cloudflare como caminho definitivo: o túnel vive
# numa conta de terceiro — a da agência, não a da Coral — e a entrega de um
# site não deve depender da infraestrutura de quem o construiu.
#
# O certificado é emitido e renovado sozinho pelo Let's Encrypt, sem cron nem
# passo manual. É o motivo de escolher Caddy em vez de Nginx aqui: num servidor
# que ninguém vai administrar no dia a dia, um certificado que expira é o site
# fora do ar. A validação é pelo desafio HTTP, então a porta 80 precisa
# continuar aberta mesmo depois que todo o tráfego migrar para HTTPS.
{
	# Para onde o Let's Encrypt avisa de certificado perto de expirar — o único
	# aviso que chega antes de o site cair.
	email contato@lanchascoral.com.br

	# Emissor fixo. Sem esta linha o Caddy tenta o Let's Encrypt e, se falhar,
	# cai no ZeroSSL sozinho — e o site passaria a depender de um emissor que
	# ninguém escolheu nem acompanha. Melhor falhar visivelmente num emissor
	# conhecido do que ter sucesso silencioso em outro.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ATENÇÃO à ordem da virada: o Caddy pede o certificado assim que sobe, e o
# Let's Encrypt valida indo buscar um arquivo em http://<domínio>/.well-known/.
# Enquanto o DNS apontar para outro lugar, a tentativa falha com 403 — e falhas
# contam contra o teto de 5 por hora do Let's Encrypt. Por isso o domínio só
# entra neste arquivo quando o registro A já estiver apontando para este
# servidor, com a nuvem da Cloudflare CINZA: laranja faz a Cloudflare
# interceptar o desafio e a emissão nunca conclui.

lanchascoral.com.br {
	# `app` é o nome do serviço no compose; o Docker resolve pela rede interna.
	# A aplicação continua sem publicar porta no host — só o Caddy a alcança.
	reverse_proxy app:3000 {
		# O IP real de quem acessa. Sem isto, o teto de envios por IP do
		# formulário veria todos os visitantes como o mesmo endereço (o do
		# contêiner do Caddy) e barraria gente legítima depois de alguns envios.
		header_up X-Real-IP {remote_host}
	}

	# Compressão. O Next já serve o estático comprimido, mas o HTML renderizado
	# no servidor sai cru — e é o que chega primeiro em toda navegação.
	encode zstd gzip

	# Os cabeçalhos de segurança (CSP, HSTS, X-Frame-Options) são definidos pelo
	# Next, em `next.config.ts`, que é onde a CSP pode ser lida e testada junto
	# do código que ela restringe. Repetir aqui criaria duas fontes de verdade
	# que divergem na primeira alteração; o Caddy apenas não os remove.

	log {
		output file /var/log/caddy/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Dois endereços servindo o mesmo conteúdo são dois sites para o Google, que
# divide a autoridade entre eles. O canonical das páginas já aponta para o
# apex; o 301 torna a regra válida para quem digita o www à mão.
www.lanchascoral.com.br {
	redir https://lanchascoral.com.br{uri} permanent
}
